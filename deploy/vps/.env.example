# Copy to deploy/vps/.env on the VPS. The real file is gitignored.
# Use a long random hexadecimal value so interpolation into DATABASE_URL remains URL-safe.
POSTGRES_PASSWORD=replace-with-long-random-hex-password
JWT_SECRET=replace-with-at-least-32-random-bytes
GATEWAY_ADMIN_EMAIL=admin@gld.com
GATEWAY_ADMIN_NAME=System Admin
GATEWAY_ADMIN_PASSWORD=replace-with-at-least-12-characters

# The HQ browser runs locally. Keep the API reachable only through WireGuard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SYNC_CRON_EXPRESSION="*/30 * * * * *"
SYNC_REQUEST_TIMEOUT_MS=20000
READING_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=7
CRITICAL_EVENT_RETENTION_DAYS=90

# Replace each address with the corresponding RU backend's WireGuard address.
GATEWAY_RU2_BASE_URL=http://RU2_VPN_IP:4000/graphql
GATEWAY_RU2_SYNC_KEY=replace-with-ru2-key
GATEWAY_RU3_BASE_URL=http://RU3_VPN_IP:4000/graphql
GATEWAY_RU3_SYNC_KEY=replace-with-ru3-key
GATEWAY_RU4_BASE_URL=http://RU4_VPN_IP:4000/graphql
GATEWAY_RU4_SYNC_KEY=replace-with-ru4-key
GATEWAY_RU5_BASE_URL=http://RU5_VPN_IP:4000/graphql
GATEWAY_RU5_SYNC_KEY=replace-with-ru5-key
GATEWAY_RU6_BASE_URL=http://RU6_VPN_IP:4000/graphql
GATEWAY_RU6_SYNC_KEY=replace-with-ru6-key
GATEWAY_RU7_BASE_URL=http://RU7_VPN_IP:4000/graphql
GATEWAY_RU7_SYNC_KEY=replace-with-ru7-key
