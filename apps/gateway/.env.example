# Aggregate DB. PostgreSQL is required for the VPS gateway.
DATABASE_URL="postgresql://gasguard:change-me@localhost:5432/gasguard?schema=public"

# HTTP port for this service's GraphQL API (consumed by apps/frontend).
PORT=4100

# Optional override for the sync cron schedule (node-cron syntax). Defaults
# to every 30 seconds if unset.
# SYNC_CRON_EXPRESSION="*/30 * * * * *"

# Browser origins allowed to call the GraphQL API.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Retention. Devices and source configuration are retained indefinitely.
READING_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=7
CRITICAL_EVENT_RETENTION_DAYS=90

# ── Sync sources (used by `prisma db seed`) ──────────────────────
# Comma-separated RU ids this gateway aggregates. One RuSource row per RU.
GATEWAY_RU_IDS="RU2,RU3,RU4,RU5,RU6,RU7"

# Base URL of each RU's backend GraphQL endpoint. In dev all RUs share the
# single local backend; in production each RU has its own host.
# GATEWAY_RU_BASE_URL="http://localhost:4000/graphql"

# Must equal the RU backend's GATEWAY_SYNC_KEY (sent as `x-gateway-key`).
# GATEWAY_SYNC_KEY="change-me-per-ru-site"

# Production uses a distinct VPN URL and key per RU. These override the shared
# development fallback above. Do not commit real values.
GATEWAY_RU2_BASE_URL="http://RU2_VPN_IP:4000/graphql"
GATEWAY_RU2_SYNC_KEY="change-me"
GATEWAY_RU3_BASE_URL="http://RU3_VPN_IP:4000/graphql"
GATEWAY_RU3_SYNC_KEY="change-me"
GATEWAY_RU4_BASE_URL="http://RU4_VPN_IP:4000/graphql"
GATEWAY_RU4_SYNC_KEY="change-me"
GATEWAY_RU5_BASE_URL="http://RU5_VPN_IP:4000/graphql"
GATEWAY_RU5_SYNC_KEY="change-me"
GATEWAY_RU6_BASE_URL="http://RU6_VPN_IP:4000/graphql"
GATEWAY_RU6_SYNC_KEY="change-me"
GATEWAY_RU7_BASE_URL="http://RU7_VPN_IP:4000/graphql"
GATEWAY_RU7_SYNC_KEY="change-me"

# HQ/global-admin account created by the seed.
# GATEWAY_ADMIN_EMAIL="admin@gld.com"
# GATEWAY_ADMIN_NAME="System Admin"
# GATEWAY_ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Operator JWT signing secret. Use at least 32 random bytes in production.
JWT_SECRET="dev-secret-change-me-before-production"
