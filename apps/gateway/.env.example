# Aggregate DB. SQLite for local dev/testing; switch to Postgres in production
# (see apps/backend's "Production DB Plan" note — same reasoning applies here).
DATABASE_URL="file:./dev.db"

# HTTP port for this service's GraphQL API (consumed by apps/frontend).
PORT=4100

# Optional override for the sync cron schedule (node-cron syntax). Defaults
# to every 30 seconds if unset.
# SYNC_CRON_EXPRESSION="*/30 * * * * *"

# ── Sync sources (used by `prisma db seed`) ──────────────────────
# Comma-separated RU ids this gateway aggregates. One RuSource row per RU.
# GATEWAY_RU_IDS="RU4"

# Base URL of each RU's backend GraphQL endpoint. In dev all RUs share the
# single local backend; in production each RU has its own host.
# GATEWAY_RU_BASE_URL="http://localhost:4000/graphql"

# Must equal the RU backend's GATEWAY_SYNC_KEY (sent as `x-gateway-key`).
# GATEWAY_SYNC_KEY="change-me-per-ru-site"

# HQ/global-admin account created by the seed.
# GATEWAY_ADMIN_EMAIL="admin@gld.com"
# GATEWAY_ADMIN_NAME="System Admin"
