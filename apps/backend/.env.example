# Database — Prisma uses SQLite (file:./prisma/dev.db) hardcoded in schema.prisma
# This file is kept for tooling compatibility but the URL below is not read by Prisma.
DATABASE_URL="file:./prisma/dev.db"

# Shared secret the VPS gateway must send as the `x-gateway-key` header when
# calling the gatewayPull query. One value per RU site.
GATEWAY_SYNC_KEY="change-me-per-ru-site"

# Operator JWT signing secret. Use at least 32 random bytes in production.
JWT_SECRET="dev-secret-change-me-before-production"

# Required in x-ingest-key for the addReading mutation.
DEVICE_INGEST_KEY="change-me-device-ingest-key"

# MQTT ingest from the PertaminaGLD Node-RED flow (gld/server/*, gld/gateway/status).
# Leave MQTT_URL empty to disable. Node-RED bench default broker: 127.0.0.1:1884.
MQTT_URL="mqtt://127.0.0.1:1884"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="gasguard-ru-backend"
# A field device with no frame for this long is shown OFFLINE.
DEVICE_OFFLINE_AFTER_SEC="900"
RU_ID="RU4"
